rules_version = '2';
// Firestore security rules for the Clinical Reasoning Engine.
// Paste into Firebase console -> Firestore Database -> Rules, then Publish.
// Keep this file and the console in sync.
service cloud.firestore {
  match /databases/{database}/documents {
    // Each student can read and write only their own attempts.
    match /users/{userId}/attempts/{attemptId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
